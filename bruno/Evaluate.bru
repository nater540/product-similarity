meta {
  name: Evaluate
  type: grpc
  seq: 4
}

grpc {
  url: {{server}}
  method: /recordsimilarity.v1.RecordSimilarity/Evaluate
  body: grpc
  protoPath: ../crates/similarity-proto/proto/recordsimilarity/v1/similarity.proto
  auth: none
  methodType: unary
}

body:grpc {
  name: message 1
  content: '''
    {
      "record": {
        "id": "bruno-1",
        "brand_id": "brand-1",
        "fields": {
          "name": "Blueberry Gummies 100mg",
          "category": "Edibles > Gummies",
          "brand": "Sunny Orchard",
          "description": "Ten vegan fruit gummies, indica-leaning, with a ripe blueberry flavor. 10mg THC per piece, 100mg per pouch."
        },
        "quantities": {
          "weight_per_item": {
            "min": 40,
            "max": 40,
            "unit": "g"
          },
          "thc_per_item": {
            "min": 100,
            "max": 100,
            "unit": "mg"
          }
        }
      },
      "mode": "WRITE_MODE_ENFORCE"
    }
  '''
}

docs {
  The first record for an id becomes its baseline: `VERDICT_CREATED`.
  
  <br/>
  
  **Notes:**
  
  `brand_id` is the primary key of the brand that owns the record.
}
