meta {
  name: Find
  seq: 3
}

auth {
  mode: inherit
}

docs {
  `FindSimilar` around a record that is not stored: the text is embedded for the search and nothing is kept.
  `FindSimilar` at the top of the collection searches around a stored record by its `id`.
  
  Send `Import` first, so that there is something to find.
}
