meta {
  name: Convert
  type: grpc
  seq: 4
}

grpc {
  url: {{server}}
  method: /recordsimilarity.v1.Quantities/Convert
  body: grpc
  protoPath: ../crates/similarity-proto/proto/recordsimilarity/v1/similarity.proto
  auth: none
  methodType: unary
}

body:grpc {
  name: message 1
  content: '''
    {
      "quantity": {
        "min": 3.5,
        "max": 3.5,
        "unit": "g"
      },
      "to_unit": "oz"
    }
  '''
}

docs {
  Writes one quantity in another unit. 3.5 g is 0.12345886682353145 oz, and both dimensions are `DIMENSION_MASS`.
}
