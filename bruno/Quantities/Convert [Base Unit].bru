meta {
  name: Convert [Base Unit]
  type: grpc
  seq: 5
}

grpc {
  url: {{server}}
  method: /recordsimilarity.v1.Quantities/Convert
  body: grpc
  protoPath: ../crates/similarity-proto/proto/recordsimilarity/v1/similarity.proto
  auth: none
  methodType: unary
}

body:grpc {
  name: message 1
  content: '''
    {
      "quantity": {
        "min": 0.125,
        "max": 0.125,
        "unit": "oz"
      }
    }
  '''
}

docs {
  With no `to_unit`, the answer is in the unit the quantity's kind is compared in: `mg`, `ml`, or `%`.
  
  An eighth of an ounce is 3543.690390625 mg, which is 3.54 g and not 3.5.
}
