grpc {
  url: {{server}}
  method: /recordsimilarity.v1.RecordSimilarity/Import
  body: grpc
  protoPath: ../crates/similarity-proto/proto/recordsimilarity/v1/similarity.proto
  auth: none
  methodType: bidi-streaming
}

body:grpc {
  name: message 1
  content: '''
    {
      "record": {
        "id": "bruno-import-1",
        "brand_id": "brand-1",
        "fields": {
          "name": "Blueberry Gummies 100mg",
